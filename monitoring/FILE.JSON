{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "prometheus",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "stat",
      "title": "Total Requests",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(http_requests_total)",
          "legendFormat": "Requests"
        }
      ],
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Requests Per Second",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m]))",
          "legendFormat": "RPS"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 }
    },
    {
      "type": "timeseries",
      "title": "Average Latency (Seconds)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_sum[1m]) / rate(http_request_duration_seconds_count[1m])",
          "legendFormat": "Latency"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 }
    },
    {
      "type": "timeseries",
      "title": "Requests by Status Code",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (status)",
          "legendFormat": "Status {{status}}"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 }
    },
    {
      "type": "timeseries",
      "title": "Requests by Endpoint",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (path)",
          "legendFormat": "{{path}}"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 }
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "title": "FastAPI Monitoring Dashboard",
  "version": 1
}
